@startuml UML用例图
' 多人共享记账系统 —— 用例图（按三类角色划分）
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam nodesep 22
skinparam ranksep 90
left to right direction

actor "只读成员" as R
actor "普通成员" as M
actor "账本管理员" as A

rectangle "多人共享记账系统" {
  usecase "登录 / 注册" as UC1
  usecase "按条件查询记录" as UC2
  usecase "查看统计与预算" as UC3
  usecase "新增收支记录" as UC4
  usecase "撤回待审核记录" as UC5
  usecase "提交更正记录" as UC6
  usecase "审核 / 驳回记录" as UC7
  usecase "作废已审核记录" as UC8
  usecase "管理账本与成员" as UC9
  usecase "发起周期结算" as UC10
  usecase "查看操作日志" as UC11
}

R --> UC1
R --> UC2
R --> UC3

M --> UC1
M --> UC2
M --> UC3
M --> UC4
M --> UC5
M --> UC6

A --|> M
A --> UC7
A --> UC8
A --> UC9
A --> UC10
A --> UC11

@enduml
